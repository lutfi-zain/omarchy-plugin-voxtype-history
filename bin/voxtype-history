#!/usr/bin/env python3
"""Log Voxtype dictations and manage the local history store."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import select
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import uuid
from datetime import datetime, timezone
from pathlib import Path

PLUGIN_NAME = "voxtype-history"
DEFAULT_MAX_ENTRIES = 500
HOOK_TIMEOUT_MS = 5000
MAX_TRANSCRIPT_BYTES = 256 * 1024
MAX_HISTORY_BYTES = 8 * 1024 * 1024
MAX_CONFIG_BYTES = 1024 * 1024
MAX_META_BYTES = 64 * 1024
MAX_CHAIN_TIMEOUT_MS = 600000
# Extra budget written into Voxtype's timeout_ms beyond the chained command's own
# timeout, so the hook always finishes (or kills the chain) before Voxtype
# SIGKILLs the hook and orphans the chain.
CHAIN_BUDGET_MARGIN_MS = 2000
# Below HOOK_TIMEOUT_MS so a contended lock still lets `log` emit the transcript
# before Voxtype gives up on the hook.
LOCK_TIMEOUT_S = 3.0
OPEN_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
OPEN_CLOEXEC = getattr(os, "O_CLOEXEC", 0)
OPEN_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
OPEN_NOCTTY = getattr(os, "O_NOCTTY", 0)


def data_dir() -> Path:
    root = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    return Path(root) / PLUGIN_NAME


def audio_dir() -> Path:
    return data_dir() / "audio"


def active_rec_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or str(data_dir())
    return Path(runtime) / f"{PLUGIN_NAME}-active.json"


def voxtype_config_path() -> Path:
    root = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(root) / "voxtype" / "config.toml"


def history_path() -> Path:
    return data_dir() / "history.jsonl"


def meta_path() -> Path:
    return data_dir() / "meta.json"


def lock_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or str(data_dir())
    return Path(runtime) / f"{PLUGIN_NAME}.lock"


def hook_command() -> str:
    # Single-quoted for the shell Voxtype runs the command with, so a path
    # containing spaces cannot split into extra arguments.
    return f"'{Path(__file__).resolve()}' log"


def ensure_dirs() -> None:
    path = data_dir()
    refuse_symlink(path)
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Tighten mode via fd so a replaced data dir cannot redirect the chmod.
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | OPEN_NOFOLLOW | OPEN_CLOEXEC
    fd = os.open(path, flags)
    try:
        os.fchmod(fd, 0o700)
    finally:
        os.close(fd)

    aud = audio_dir()
    refuse_symlink(aud)
    aud.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd2 = os.open(aud, flags)
    try:
        os.fchmod(fd2, 0o700)
    finally:
        os.close(fd2)


class StoreLock:
    def __init__(self) -> None:
        self.fd = -1

    def __enter__(self) -> "StoreLock":
        ensure_dirs()
        path = lock_path()
        flags = os.O_RDWR | os.O_CREAT | OPEN_NOFOLLOW | OPEN_CLOEXEC | OPEN_NONBLOCK | OPEN_NOCTTY
        fd = os.open(path, flags, 0o600)
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise OSError(f"refusing non-regular lock file: {path}")
            deadline = time.monotonic() + LOCK_TIMEOUT_S
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise OSError(f"timed out waiting for lock: {path}") from None
                    time.sleep(0.05)
        except BaseException:
            os.close(fd)
            raise
        self.fd = fd
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        if self.fd >= 0:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd)
                self.fd = -1


def path_present(path: Path) -> bool:
    try:
        path.lstat()
        return True
    except OSError:
        return False


def refuse_symlink(path: Path) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return
    if stat.S_ISLNK(info.st_mode):
        raise OSError(f"refusing symlink: {path}")


def clip_transcript(text: str, max_bytes: int = MAX_TRANSCRIPT_BYTES) -> str:
    encoded = text.encode("utf-8")
    if len(encoded) <= max_bytes:
        return text
    return encoded[:max_bytes].decode("utf-8", errors="replace")


def read_bytes_limited(path: Path, max_bytes: int, truncate: bool = True) -> bytes:
    refuse_symlink(path)
    flags = os.O_RDONLY | OPEN_NOFOLLOW | OPEN_CLOEXEC | OPEN_NONBLOCK | OPEN_NOCTTY
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError(f"refusing non-regular file: {path}")
        try:
            os.set_blocking(fd, True)
        except OSError:
            pass
        chunks = []
        total = 0
        limit = max_bytes if truncate else max_bytes + 1
        while total < limit:
            chunk = os.read(fd, min(65536, limit - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        data = b"".join(chunks)
    finally:
        os.close(fd)
    if not truncate and len(data) > max_bytes:
        raise OSError(f"file too large: {path}")
    return data[:max_bytes]


def read_text_limited(path: Path, max_bytes: int, truncate: bool = True) -> str:
    return read_bytes_limited(path, max_bytes, truncate=truncate).decode("utf-8", errors="replace")


def read_stdin_limited(max_bytes: int) -> str:
    buf = bytearray()
    while len(buf) <= max_bytes:
        chunk = sys.stdin.buffer.read(min(65536, max_bytes + 1 - len(buf)))
        if not chunk:
            break
        buf.extend(chunk)
    return bytes(buf[:max_bytes]).decode("utf-8", errors="replace")


def read_json(path: Path, fallback):
    try:
        return json.loads(read_text_limited(path, MAX_META_BYTES))
    except (OSError, json.JSONDecodeError):
        return fallback


def file_mode(path: Path, fallback: int = 0o600) -> int:
    try:
        info = path.lstat()
    except OSError:
        return fallback
    if stat.S_ISLNK(info.st_mode):
        raise OSError(f"refusing symlink: {path}")
    return stat.S_IMODE(info.st_mode)


def write_text_atomic(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    refuse_symlink(path)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=str(path.parent))
    tmp = Path(tmp_name)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = -1
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        refuse_symlink(path)
        os.replace(tmp, path)
        tmp = None
    finally:
        if fd >= 0:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp is not None:
            try:
                tmp.unlink(missing_ok=True)
            except OSError:
                pass


def default_meta() -> dict:
    return {
        "paused": False,
        "maxEntries": DEFAULT_MAX_ENTRIES,
        "previousCommand": None,
        "previousTimeoutMs": None,
    }


def load_meta() -> dict:
    meta = default_meta()
    loaded = read_json(meta_path(), {})
    if isinstance(loaded, dict):
        meta.update(loaded)
    meta["paused"] = bool(meta.get("paused"))
    try:
        meta["maxEntries"] = max(1, int(meta.get("maxEntries") or DEFAULT_MAX_ENTRIES))
    except (TypeError, ValueError):
        meta["maxEntries"] = DEFAULT_MAX_ENTRIES
    return meta


def save_meta(meta: dict) -> None:
    write_text_atomic(meta_path(), json.dumps(meta, indent=2) + "\n")


def delete_audio_for_entry(entry: dict) -> None:
    audio = entry.get("audio")
    if audio:
        try:
            Path(audio).unlink(missing_ok=True)
        except OSError:
            pass
    ident = entry.get("id")
    if ident:
        try:
            (audio_dir() / f"{ident}.wav").unlink(missing_ok=True)
        except OSError:
            pass


def normalize_entry(raw) -> dict | None:
    if not isinstance(raw, dict):
        return None
    text = clip_transcript(str(raw.get("text") or ""))
    ident = str(raw.get("id") or "")
    if not ident or not text.strip():
        return None
    entry = {
        "id": ident,
        "ts": str(raw.get("ts") or ""),
        "text": text,
        "pinned": bool(raw.get("pinned")),
    }
    audio = raw.get("audio")
    if audio and isinstance(audio, str):
        entry["audio"] = audio
    return entry


def load_entries() -> list[dict]:
    path = history_path()
    if not path_present(path):
        return []
    entries = []
    try:
        raw = read_text_limited(path, MAX_HISTORY_BYTES)
    except OSError:
        return []
    if raw and not raw.endswith("\n") and "\n" in raw:
        raw = raw.rsplit("\n", 1)[0]
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            entry = normalize_entry(json.loads(line))
        except json.JSONDecodeError:
            continue
        if entry:
            entries.append(entry)
    return entries


def dump_entries(entries: list[dict]) -> None:
    body = "".join(json.dumps(entry, ensure_ascii=False) + "\n" for entry in entries)
    write_text_atomic(history_path(), body)


def prune_entries(entries: list[dict], max_entries: int) -> list[dict]:
    pinned = [entry for entry in entries if entry.get("pinned")]
    unpinned = [entry for entry in entries if not entry.get("pinned")]
    overflow = max(0, len(unpinned) - max_entries)
    if overflow:
        dropped = unpinned[:overflow]
        for item in dropped:
            delete_audio_for_entry(item)
        unpinned = unpinned[overflow:]
    return pinned + unpinned


def new_entry(text: str, ident: str | None = None, audio_path: str | None = None) -> dict:
    item = {
        "id": ident or uuid.uuid4().hex[:12],
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "text": clip_transcript(text),
        "pinned": False,
    }
    if audio_path:
        item["audio"] = audio_path
    return item


def find_entry(entries: list[dict], ident: str) -> dict | None:
    for entry in entries:
        if entry["id"] == ident:
            return entry
    return None


def today_count(entries: list[dict]) -> int:
    today = datetime.now().date()
    count = 0
    for entry in entries:
        try:
            stamp = datetime.fromisoformat(entry["ts"].replace("Z", "+00:00")).astimezone()
        except ValueError:
            continue
        if stamp.date() == today:
            count += 1
    return count


def post_process_section(text: str) -> re.Match[str] | None:
    return re.search(r"(?ms)^\[output\.post_process\]\s*(.*?)(?=^\[|\Z)", text)


def uncommented_command_line(body: str) -> str | None:
    for line in body.splitlines():
        if re.match(r"^\s*#", line):
            continue
        match = re.match(r"^\s*command\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|(\S+))", line)
        if match:
            return match.group(1) or match.group(2) or match.group(3)
    return None


def config_is_wired(text: str, hook: str | None = None) -> bool:
    section = post_process_section(text)
    body = section.group(0) if section else ""
    command = uncommented_command_line(body)
    if not command:
        return False
    if hook:
        return hook in command
    return PLUGIN_NAME in command


def extract_timeout_ms(body: str) -> int | None:
    match = re.search(r"(?m)^\s*timeout_ms\s*=\s*(\d+)", body)
    if not match:
        return None
    return int(match.group(1))


def toml_quote(value: str) -> str:
    """Escape a string for embedding in a double-quoted TOML basic string."""
    out = []
    for ch in value:
        if ch == "\\":
            out.append("\\\\")
        elif ch == '"':
            out.append('\\"')
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif ord(ch) < 0x20 or ch == "\x7f":
            out.append(f"\\u{ord(ch):04X}")
        else:
            out.append(ch)
    return "".join(out)


def extract_previous_chain(original: str, section_body: str) -> tuple[str | None, int | None]:
    """Previous post_process command and timeout, preferring a real TOML parse
    so escaped strings round-trip; regex fallback for unparseable configs."""
    try:
        parsed = tomllib.loads(original)
    except Exception:
        parsed = None
    if isinstance(parsed, dict):
        output = parsed.get("output")
        post = output.get("post_process") if isinstance(output, dict) else None
        post = post if isinstance(post, dict) else {}
        command = post.get("command")
        timeout = post.get("timeout_ms")
        return (
            command if isinstance(command, str) and command else None,
            timeout if isinstance(timeout, int) and timeout > 0 else None,
        )
    return uncommented_command_line(section_body), extract_timeout_ms(section_body)


def enable_in_config(config_path: Path, hook: str, timeout_ms: int) -> dict:
    original = ""
    original_mode = 0o600
    if path_present(config_path):
        original = read_text_limited(config_path, MAX_CONFIG_BYTES, truncate=False)
        original_mode = file_mode(config_path)
    backup = None
    if original:
        backup = config_path.with_name(f"{config_path.name}.bak.{int(time.time())}")
        write_text_atomic(backup, original, mode=original_mode)

    previous_command = None
    previous_timeout = None
    section = post_process_section(original)
    if section:
        previous_command, previous_timeout = extract_previous_chain(original, section.group(1))
        if previous_command and PLUGIN_NAME in previous_command:
            previous_command = None
            previous_timeout = None

    # Voxtype's timeout must cover the chained command's own timeout, or Voxtype
    # SIGKILLs the hook mid-chain (losing the dictation, orphaning the chain).
    effective_timeout = timeout_ms
    if previous_command:
        chain_ms = min(previous_timeout or 30000, MAX_CHAIN_TIMEOUT_MS)
        effective_timeout = max(timeout_ms, chain_ms + CHAIN_BUDGET_MARGIN_MS)

    block = (
        "[output.post_process]\n"
        f'command = "{toml_quote(hook)}"\n'
        f"timeout_ms = {effective_timeout}\n"
    )
    if section:
        start, end = section.span()
        updated = original[:start] + block + original[end:].lstrip("\n")
        if not updated.endswith("\n"):
            updated += "\n"
    else:
        updated = original.rstrip() + "\n\n" + block
        if not updated.endswith("\n"):
            updated += "\n"

    hook_bin = hook[:-4] if hook.endswith(" log") else hook
    rec_start_cmd = f"{hook_bin} record-start"
    rec_stop_cmd = f"{hook_bin} record-stop"
    updated = re.sub(
        r'(?m)^\s*(pre_recording_command|post_output_command)\s*=.*?' + re.escape(PLUGIN_NAME) + r'.*?\n',
        '',
        updated,
    )
    out_section = re.search(r"(?m)^\[output\]\s*$", updated)
    if out_section:
        pos = out_section.end()
        cmds = (
            f'\npre_recording_command = "{toml_quote(rec_start_cmd)}"\n'
            f'post_output_command = "{toml_quote(rec_stop_cmd)}"'
        )
        updated = updated[:pos] + cmds + updated[pos:]
    write_text_atomic(config_path, updated, mode=original_mode)
    return {
        "backup": str(backup) if backup else None,
        "previousCommand": previous_command,
        "previousTimeoutMs": previous_timeout,
        "wired": True,
    }


def disable_in_config(config_path: Path, previous_command: str | None, previous_timeout: int | None) -> dict:
    if not path_present(config_path):
        return {"wired": False}
    original = read_text_limited(config_path, MAX_CONFIG_BYTES, truncate=False)
    section = post_process_section(original)
    if not section:
        return {"wired": False}

    if previous_command:
        timeout = previous_timeout if previous_timeout else 30000
        block = (
            "[output.post_process]\n"
            f'command = "{toml_quote(previous_command)}"\n'
            f"timeout_ms = {timeout}\n"
        )
        start, end = section.span()
        updated = original[:start] + block + original[end:].lstrip("\n")
    else:
        start, end = section.span()
        updated = original[:start] + original[end:]
        updated = re.sub(r"\n{3,}", "\n\n", updated)

    updated = re.sub(
        r'(?m)^\s*(pre_recording_command|post_output_command)\s*=.*?' + re.escape(PLUGIN_NAME) + r'.*?\n',
        '',
        updated,
    )
    write_text_atomic(config_path, updated, mode=file_mode(config_path))
    return {"wired": False}


def restart_voxtype() -> None:
    try:
        subprocess.run(
            ["systemctl", "--user", "try-restart", "voxtype.service"],
            check=False,
            timeout=30,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.TimeoutExpired:
        pass


def write_stdin_deadline(handle, data: bytes, deadline: float) -> bool:
    """Write stdin without blocking past deadline. Closes handle.
    False on timeout or unexpected write error; a child that stops reading
    on purpose (EPIPE) is not a failure — its exit code decides."""
    fd = handle.fileno()
    try:
        os.set_blocking(fd, False)
    except OSError:
        pass
    view = memoryview(data)
    offset = 0
    on_time = True
    try:
        while offset < len(view):
            wait = deadline - time.monotonic()
            if wait <= 0:
                on_time = False
                break
            try:
                _, ready, _ = select.select([], [fd], [], wait)
            except OSError:
                on_time = False
                break
            if not ready:
                on_time = False
                break
            try:
                written = os.write(fd, view[offset : offset + 65536])
            except BlockingIOError:
                continue
            except BrokenPipeError:
                # Child closed stdin on purpose (e.g. head); its exit code decides.
                break
            except OSError:
                on_time = False
                break
            if written == 0:
                break
            offset += written
        return on_time
    finally:
        try:
            handle.close()
        except OSError:
            pass


def kill_chain(proc: subprocess.Popen) -> None:
    """Kill the chained command and any grandchildren it spawned."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        proc.kill()
    except (ProcessLookupError, PermissionError):
        pass


def run_chain(command: str, text: str, timeout_ms: int) -> str:
    if not command.strip():
        return text
    payload = clip_transcript(text).encode("utf-8")
    try:
        proc = subprocess.Popen(
            command,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            shell=True,
            start_new_session=True,
        )
    except OSError:
        return text

    chunks: list[bytes] = []
    total = 0
    overflow = False
    deadline = time.monotonic() + max(1, timeout_ms) / 1000

    def remaining() -> float:
        return max(0.0, deadline - time.monotonic())

    def reader() -> None:
        nonlocal total, overflow
        assert proc.stdout is not None
        while True:
            want = min(65536, MAX_TRANSCRIPT_BYTES - total + 1)
            if want <= 0:
                overflow = True
                break
            chunk = proc.stdout.read(want)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > MAX_TRANSCRIPT_BYTES:
                overflow = True
                break

    thread = threading.Thread(target=reader, daemon=True)
    thread.start()
    try:
        write_ok = True
        try:
            assert proc.stdin is not None
            write_ok = write_stdin_deadline(proc.stdin, payload, deadline)
        except OSError:
            pass
        thread.join(timeout=remaining())
        timed_out = (not write_ok) or thread.is_alive()
        if timed_out or overflow:
            kill_chain(proc)
            thread.join(timeout=1)
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            kill_chain(proc)
            proc.wait()
            return text
        decoded = b"".join(chunks)[:MAX_TRANSCRIPT_BYTES].decode("utf-8", errors="replace")
        if timed_out:
            return text
        if overflow:
            return decoded if decoded.strip() else text
        if proc.returncode != 0:
            return text
        return decoded if decoded else text
    finally:
        if proc.stdout is not None:
            try:
                proc.stdout.close()
            except OSError:
                pass
        if proc.stdin is not None:
            try:
                proc.stdin.close()
            except OSError:
                pass


def copy_text(text: str) -> None:
    if not shutil.which("wl-copy"):
        raise SystemExit("wl-copy is not installed")
    try:
        result = subprocess.run(["wl-copy"], input=text, text=True, check=False, timeout=10)
    except subprocess.TimeoutExpired:
        raise SystemExit("wl-copy timed out")
    if result.returncode != 0:
        raise SystemExit("wl-copy failed")


def stop_active_recording(discard_if_empty: bool = False) -> dict | None:
    path = active_rec_path()
    if not path_present(path):
        return None
    data = read_json(path, {})
    if not isinstance(data, dict):
        try:
            path.unlink(missing_ok=True)
        except OSError:
            pass
        return None

    pid = data.get("pid")
    if isinstance(pid, int) and pid > 0:
        try:
            os.kill(pid, signal.SIGINT)
        except (ProcessLookupError, PermissionError):
            pass
        deadline = time.monotonic() + 0.5
        while time.monotonic() < deadline:
            try:
                wpid, _ = os.waitpid(pid, os.WNOHANG)
                if wpid == pid:
                    break
            except ChildProcessError:
                break
            time.sleep(0.02)
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass

    audio_file = data.get("audio")
    if discard_if_empty and audio_file:
        try:
            p = Path(audio_file)
            if p.is_file() and p.stat().st_size <= 44:
                p.unlink(missing_ok=True)
                data["audio"] = None
        except OSError:
            pass

    try:
        path.unlink(missing_ok=True)
    except OSError:
        pass
    return data


def cmd_record_start(_args: argparse.Namespace) -> int:
    stop_active_recording(discard_if_empty=True)
    ensure_dirs()
    rec_id = uuid.uuid4().hex[:12]
    audio_path = audio_dir() / f"{rec_id}.wav"
    rec_bin = shutil.which("pw-record") or shutil.which("parecord") or shutil.which("arecord")
    if not rec_bin:
        return 0

    if "pw-record" in rec_bin or "parecord" in rec_bin:
        cmd = [rec_bin, "--format=s16", "--rate=16000", "--channels=1", str(audio_path)]
    else:
        cmd = [rec_bin, "-f", "S16_LE", "-r", "16000", "-c", "1", str(audio_path)]

    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        rec_data = {
            "id": rec_id,
            "pid": proc.pid,
            "audio": str(audio_path),
            "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        }
        write_text_atomic(active_rec_path(), json.dumps(rec_data, indent=2) + "\n")
        with StoreLock():
            entries = load_entries()
            entries.append({
                "id": rec_id,
                "ts": rec_data["ts"],
                "text": "(Recording in progress...)",
                "pinned": False,
                "audio": str(audio_path),
            })
            meta = load_meta()
            dump_entries(prune_entries(entries, meta["maxEntries"]))
    except OSError:
        pass
    return 0


def cmd_record_stop(_args: argparse.Namespace) -> int:
    rec_data = stop_active_recording(discard_if_empty=False)
    if rec_data and rec_data.get("audio"):
        wav = Path(rec_data["audio"])
        if wav.is_file() and wav.stat().st_size > 1024:
            with StoreLock():
                entries = load_entries()
                if not any(e["id"] == rec_data["id"] for e in entries):
                    entries.append({
                        "id": rec_data["id"],
                        "ts": rec_data.get("ts") or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                        "text": "(Interrupted - click to re-transcribe)",
                        "pinned": False,
                        "audio": str(wav),
                    })
                    meta = load_meta()
                    dump_entries(prune_entries(entries, meta["maxEntries"]))
    return 0


def recover_interrupted_recordings() -> None:
    rec_path = active_rec_path()
    if path_present(rec_path):
        data = read_json(rec_path, {})
        if isinstance(data, dict):
            pid = data.get("pid")
            is_alive = False
            if isinstance(pid, int) and pid > 0:
                try:
                    os.kill(pid, 0)
                    is_alive = True
                except (ProcessLookupError, PermissionError):
                    is_alive = False
            if not is_alive:
                try:
                    rec_path.unlink(missing_ok=True)
                except OSError:
                    pass

    entries = load_entries()
    modified = False
    for entry in entries:
        if "(Recording in progress" in entry.get("text", ""):
            entry["text"] = "(Transcription failed - click to re-transcribe)"
            modified = True
    if modified:
        meta = load_meta()
        dump_entries(prune_entries(entries, meta["maxEntries"]))


def cmd_log(_args: argparse.Namespace) -> int:
    text = clip_transcript(read_stdin_limited(MAX_TRANSCRIPT_BYTES))
    output = text
    rec_data = stop_active_recording(discard_if_empty=False)
    audio_path = None
    ident = None
    ts = None
    if rec_data:
        ident = rec_data.get("id")
        ts = rec_data.get("ts")
        wav = Path(rec_data.get("audio") or "")
        if wav.is_file() and wav.stat().st_size > 44:
            audio_path = str(wav)
        elif wav.is_file():
            try:
                wav.unlink(missing_ok=True)
            except OSError:
                pass

    try:
        with StoreLock():
            meta = load_meta()
        chain = meta.get("previousCommand")
        try:
            timeout = int(meta.get("previousTimeoutMs") or 30000)
        except (TypeError, ValueError):
            timeout = 30000
        timeout = min(MAX_CHAIN_TIMEOUT_MS, max(1, timeout))
        if chain:
            output = run_chain(str(chain), text, timeout)
        with StoreLock():
            entries = load_entries()
            existing = find_entry(entries, ident) if ident else None
            if text.strip():
                if existing:
                    existing["text"] = output if output.strip() else text
                    if audio_path:
                        existing["audio"] = audio_path
                elif not meta.get("paused"):
                    item = new_entry(output if output.strip() else text, ident=ident, audio_path=audio_path)
                    if ts:
                        item["ts"] = ts
                    entries.append(item)
                dump_entries(prune_entries(entries, meta["maxEntries"]))
            elif existing:
                # Silence / no speech detected: drop placeholder and clean empty audio
                delete_audio_for_entry(existing)
                entries = [e for e in entries if e["id"] != ident]
                dump_entries(entries)
    except Exception:
        pass
    sys.stdout.write(output)
    return 0


def cmd_status(_args: argparse.Namespace) -> int:
    with StoreLock():
        meta = load_meta()
        entries = load_entries()
        config_text = ""
        config = voxtype_config_path()
        if path_present(config):
            try:
                config_text = read_text_limited(config, MAX_CONFIG_BYTES, truncate=False)
            except OSError:
                config_text = ""
        payload = {
            "wired": config_is_wired(config_text, hook_command()) or config_is_wired(config_text),
            "paused": bool(meta.get("paused")),
            "count": len(entries),
            "todayCount": today_count(entries),
            "historyPath": str(history_path()),
            "metaPath": str(meta_path()),
            "hookPath": hook_command(),
            "voxtypeConfig": str(config),
            "maxEntries": meta["maxEntries"],
        }
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    return 0


def cmd_list(_args: argparse.Namespace) -> int:
    with StoreLock():
        recover_interrupted_recordings()
        json.dump(load_entries(), sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


def cmd_pause(args: argparse.Namespace) -> int:
    with StoreLock():
        meta = load_meta()
        meta["paused"] = not bool(getattr(args, "resume", False))
        if getattr(args, "state", None) == "on":
            meta["paused"] = True
        elif getattr(args, "state", None) == "off":
            meta["paused"] = False
        save_meta(meta)
        json.dump({"paused": meta["paused"]}, sys.stdout)
    sys.stdout.write("\n")
    return 0


def cmd_pin(args: argparse.Namespace, pinned: bool) -> int:
    with StoreLock():
        entries = load_entries()
        entry = find_entry(entries, args.id)
        if not entry:
            raise SystemExit(f"unknown id: {args.id}")
        entry["pinned"] = pinned
        dump_entries(entries)
    return 0


def cmd_delete(args: argparse.Namespace) -> int:
    with StoreLock():
        entries = load_entries()
        target = find_entry(entries, args.id)
        if not target:
            raise SystemExit(f"unknown id: {args.id}")
        delete_audio_for_entry(target)
        next_entries = [entry for entry in entries if entry["id"] != args.id]
        dump_entries(next_entries)
    return 0


def cmd_clear(args: argparse.Namespace) -> int:
    with StoreLock():
        entries = load_entries()
        if args.all:
            for entry in entries:
                delete_audio_for_entry(entry)
            dump_entries([])
        else:
            kept = []
            for entry in entries:
                if entry.get("pinned"):
                    kept.append(entry)
                else:
                    delete_audio_for_entry(entry)
            dump_entries(kept)
    return 0


def parse_voxtype_transcribe_output(raw: str) -> str:
    lines = []
    capture = False
    for line in raw.splitlines():
        if line.startswith("VAD:"):
            capture = True
            continue
        if capture:
            stripped = line.strip()
            if stripped:
                lines.append(stripped)
    if lines:
        return " ".join(lines)
    filtered = []
    for line in raw.splitlines():
        s = line.strip()
        if not s:
            continue
        if any(s.startswith(prefix) for prefix in ("Loading audio file", "Audio format", "Processing", "VAD:", "202", "INFO", "WARN", "ERROR")):
            continue
        filtered.append(s)
    return " ".join(filtered).strip()


def cmd_retranscribe(args: argparse.Namespace) -> int:
    with StoreLock():
        entries = load_entries()
        entry = find_entry(entries, args.id)
        if not entry:
            raise SystemExit(f"unknown id: {args.id}")
        audio = entry.get("audio") or str(audio_dir() / f"{args.id}.wav")
        wav = Path(audio)
        if not wav.is_file():
            raise SystemExit(f"no audio file found for id: {args.id}")

    voxtype_bin = shutil.which("voxtype") or "voxtype"
    try:
        proc = subprocess.run(
            [voxtype_bin, "-q", "transcribe", str(wav)],
            capture_output=True,
            text=True,
            timeout=60,
        )
    except subprocess.TimeoutExpired:
        raise SystemExit("transcription timed out")
    except OSError as exc:
        raise SystemExit(f"failed to run voxtype: {exc}")

    if proc.returncode != 0:
        err = proc.stderr.strip() or proc.stdout.strip()
        raise SystemExit(f"transcription failed: {err}")

    cleaned = parse_voxtype_transcribe_output(proc.stdout)
    if not cleaned:
        cleaned = "(No speech detected)"

    with StoreLock():
        entries = load_entries()
        entry = find_entry(entries, args.id)
        if entry:
            entry["text"] = cleaned
            if not entry.get("audio"):
                entry["audio"] = str(wav)
            dump_entries(entries)

    if getattr(args, "copy", True):
        try:
            copy_text(cleaned)
        except SystemExit:
            pass

    json.dump({"ok": True, "id": args.id, "text": cleaned}, sys.stdout)
    sys.stdout.write("\n")
    return 0


def cmd_copy(args: argparse.Namespace) -> int:
    with StoreLock():
        entry = find_entry(load_entries(), args.id)
    if not entry:
        raise SystemExit(f"unknown id: {args.id}")
    copy_text(entry["text"])
    return 0


def cmd_enable(_args: argparse.Namespace) -> int:
    config = voxtype_config_path()
    if not path_present(config):
        raise SystemExit(f"voxtype config not found: {config}")
    # The hook path is embedded in a single-quoted shell word inside a TOML
    # string; refuse any path that could escape either quoting layer.
    raw_path = str(Path(__file__).resolve())
    if any(ch in raw_path for ch in ("'", '"', "\\", "\n", "\r")):
        raise SystemExit(f"refusing hook path with quote, backslash, or newline: {raw_path}")
    hook = hook_command()
    with StoreLock():
        meta = load_meta()
        result = enable_in_config(config, hook, HOOK_TIMEOUT_MS)
        if result.get("previousCommand"):
            meta["previousCommand"] = result["previousCommand"]
            meta["previousTimeoutMs"] = result.get("previousTimeoutMs")
        save_meta(meta)
    restart_voxtype()
    json.dump({"ok": True, **result, "hook": hook_command()}, sys.stdout)
    sys.stdout.write("\n")
    return 0


def cmd_disable(_args: argparse.Namespace) -> int:
    config = voxtype_config_path()
    with StoreLock():
        meta = load_meta()
        result = disable_in_config(config, meta.get("previousCommand"), meta.get("previousTimeoutMs"))
        meta["previousCommand"] = None
        meta["previousTimeoutMs"] = None
        save_meta(meta)
    restart_voxtype()
    json.dump({"ok": True, **result}, sys.stdout)
    sys.stdout.write("\n")
    return 0


def cmd_recover(_args: argparse.Namespace) -> int:
    with StoreLock():
        recover_interrupted_recordings()
        entries = load_entries()
    json.dump({"ok": True, "count": len(entries)}, sys.stdout)
    sys.stdout.write("\n")
    return 0
def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="voxtype-history", description=__doc__)
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("log", help="Read stdin, log it, write it back (Voxtype post_process hook)")
    sub.add_parser("status", help="Print wired/paused/count as JSON")
    sub.add_parser("list", help="Print every history entry as JSON")

    pause = sub.add_parser("pause", help="Stop logging new dictations")
    pause.add_argument("state", nargs="?", choices=("on", "off"))
    pause.set_defaults(handler=cmd_pause)

    resume = sub.add_parser("resume", help="Resume logging")
    resume.set_defaults(handler=lambda args: cmd_pause(argparse.Namespace(resume=True, state="off")))

    pin = sub.add_parser("pin", help="Pin an entry so prune will not drop it")
    pin.add_argument("id")
    pin.set_defaults(handler=lambda args: cmd_pin(args, True))

    unpin = sub.add_parser("unpin", help="Unpin an entry")
    unpin.add_argument("id")
    unpin.set_defaults(handler=lambda args: cmd_pin(args, False))

    delete = sub.add_parser("delete", help="Delete one entry")
    delete.add_argument("id")
    delete.set_defaults(handler=cmd_delete)

    clear = sub.add_parser("clear", help="Delete unpinned entries (or everything with --all)")
    clear.add_argument("--all", action="store_true")
    clear.set_defaults(handler=cmd_clear)

    copy = sub.add_parser("copy", help="Copy an entry to the clipboard")
    copy.add_argument("id")
    copy.set_defaults(handler=cmd_copy)

    rec_start = sub.add_parser("record-start", help="Start background audio capture")
    rec_start.set_defaults(handler=cmd_record_start)

    rec_stop = sub.add_parser("record-stop", help="Stop background audio capture")
    rec_stop.set_defaults(handler=cmd_record_stop)

    retranscribe = sub.add_parser("retranscribe", help="Re-transcribe audio for an entry")
    retranscribe.add_argument("id")
    retranscribe.add_argument("--no-copy", dest="copy", action="store_false", help="Do not copy retranscribed text to clipboard")
    retranscribe.set_defaults(handler=cmd_retranscribe)

    recover = sub.add_parser("recover", help="Recover interrupted or failed recordings")
    recover.set_defaults(handler=cmd_recover)

    sub.add_parser("enable", help="Wire ~/.config/voxtype/config.toml to this hook")
    sub.add_parser("disable", help="Remove this hook from Voxtype config")
    return parser


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        argv = ["log"]
    parser = build_parser()
    args = parser.parse_args(argv)
    command = args.command or "log"
    handlers = {
        "log": cmd_log,
        "status": cmd_status,
        "list": cmd_list,
        "pause": cmd_pause,
        "enable": cmd_enable,
        "disable": cmd_disable,
        "record-start": cmd_record_start,
        "record-stop": cmd_record_stop,
        "retranscribe": cmd_retranscribe,
        "recover": cmd_recover,
    }
    if hasattr(args, "handler"):
        return args.handler(args)
    handler = handlers.get(command)
    if not handler:
        parser.print_help()
        return 2
    return handler(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        raise SystemExit(0)
